# Copy to .env.local for local dev. Never commit real secrets.

# Signs the session cookie. REQUIRED in production: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# demo = pick a demo user on the sign-in page (no IdP needed)
AUTH_MODE=demo

# false = placeholder AI replies (no AWS needed). true = call AWS Bedrock.
BEDROCK_ENABLED=false
AWS_REGION=eu-west-1

# Bedrock model IDs. Check the exact IDs enabled in your account/region
# (Bedrock console -> Model catalog). Some models need an inference profile ID, e.g. eu.anthropic...
BEDROCK_MODEL_CLAUDE=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_NOVA=amazon.nova-pro-v1:0
BEDROCK_MODEL_GPTOSS=openai.gpt-oss-120b-1:0
BEDROCK_MODEL_LLAMA=meta.llama3-3-70b-instruct-v1:0
